{
  "name": "Audio \u00b7 Telephony speech",
  "version": 1,
  "kind": "route",
  "route_id": "R04",
  "priority": 5,
  "description": "Narrowband (8 kHz) or telephone codec. Telephony-suited quality model; bandwidth check off.",
  "profile": "Balanced",
  "trigger": [
    [
      "sample_rate",
      "<=",
      8000
    ]
  ],
  "steps": [
    {
      "id": "decode.probe"
    },
    {
      "id": "decode.full"
    },
    {
      "id": "gates.basic"
    },
    {
      "id": "cache.lookup"
    },
    {
      "id": "dsp.levels"
    },
    {
      "id": "dsp.loudness"
    },
    {
      "id": "dsp.silence"
    },
    {
      "id": "dsp.bit_depth"
    },
    {
      "id": "dsp.spectral"
    },
    {
      "id": "dsp.hum"
    },
    {
      "id": "dsp.dropouts"
    },
    {
      "id": "dsp.stereo"
    },
    {
      "id": "snr.wada"
    },
    {
      "id": "fingerprint.compute"
    },
    {
      "id": "classify.content.gpu"
    },
    {
      "id": "speaker.embed",
      "when": [
        [
          "content_class",
          "==",
          "speech"
        ]
      ]
    },
    {
      "id": "vad"
    },
    {
      "id": "snr_c50"
    },
    {
      "id": "quality.general",
      "params": {
        "model_hint": "telephony"
      }
    },
    {
      "id": "mos.speech",
      "when": [
        [
          "profile_tts",
          "==",
          true
        ]
      ]
    },
    {
      "id": "lid"
    },
    {
      "id": "asr",
      "params": {
        "model_hint": "telephony"
      }
    },
    {
      "id": "align.words"
    },
    {
      "id": "pii.detect"
    },
    {
      "id": "pii.redact"
    },
    {
      "id": "ai_detect"
    },
    {
      "id": "emotion",
      "when": [
        [
          "enrich",
          "==",
          true
        ]
      ]
    },
    {
      "id": "text.enrich",
      "when": [
        [
          "enrich",
          "==",
          true
        ]
      ]
    },
    {
      "id": "demographics",
      "when": [
        [
          "enrich",
          "==",
          true
        ]
      ]
    }
  ],
  "skips": [
    "dsp.spectral verdicts",
    "diarize unless >1 speaker"
  ],
  "preserve_originals": true,
  "privacy_required": true,
  "automatic": true
}