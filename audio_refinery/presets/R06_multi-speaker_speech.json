{
  "name": "Audio \u00b7 Multi-speaker speech",
  "version": 1,
  "kind": "route",
  "route_id": "R06",
  "priority": 8,
  "description": "Several speakers in one channel. Separation only if speech SNR is low with music or crowd.",
  "profile": "Balanced",
  "trigger": [
    [
      "content_class",
      "==",
      "speech"
    ],
    [
      "speakers_hint",
      ">",
      1
    ]
  ],
  "steps": [
    {
      "id": "decode.probe"
    },
    {
      "id": "decode.full"
    },
    {
      "id": "gates.basic"
    },
    {
      "id": "cache.lookup"
    },
    {
      "id": "dsp.levels"
    },
    {
      "id": "dsp.loudness"
    },
    {
      "id": "dsp.silence"
    },
    {
      "id": "dsp.bit_depth"
    },
    {
      "id": "dsp.spectral"
    },
    {
      "id": "dsp.hum"
    },
    {
      "id": "dsp.dropouts"
    },
    {
      "id": "dsp.stereo"
    },
    {
      "id": "snr.wada"
    },
    {
      "id": "fingerprint.compute"
    },
    {
      "id": "classify.content.gpu"
    },
    {
      "id": "speaker.embed",
      "when": [
        [
          "content_class",
          "==",
          "speech"
        ]
      ]
    },
    {
      "id": "vad"
    },
    {
      "id": "snr_c50"
    },
    {
      "id": "quality.general"
    },
    {
      "id": "mos.speech",
      "when": [
        [
          "profile_tts",
          "==",
          true
        ]
      ]
    },
    {
      "id": "lid"
    },
    {
      "id": "asr"
    },
    {
      "id": "align.words"
    },
    {
      "id": "pii.detect"
    },
    {
      "id": "pii.redact"
    },
    {
      "id": "ai_detect"
    },
    {
      "id": "diarize"
    },
    {
      "id": "separate.vocals",
      "when": [
        [
          "snr_wada_db",
          "<",
          10
        ]
      ]
    },
    {
      "id": "emotion",
      "when": [
        [
          "enrich",
          "==",
          true
        ]
      ]
    },
    {
      "id": "text.enrich",
      "when": [
        [
          "enrich",
          "==",
          true
        ]
      ]
    },
    {
      "id": "demographics",
      "when": [
        [
          "enrich",
          "==",
          true
        ]
      ]
    }
  ],
  "skips": [
    "separation on clean speech"
  ],
  "preserve_originals": true,
  "privacy_required": true,
  "automatic": true
}